# Copy to .env and edit. Never commit .env.
PORT=3000
NODE_ENV=production            # use "production" when served over HTTPS
TRUST_PROXY=1                  # set to 1 if behind nginx / a hosting proxy

# First admin account (created only if no admin exists yet).
# If ADMIN_PASSWORD is empty a random one is printed once in the console.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=

# Email (needed to send confirmation / reset codes). Without it, codes are printed in the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fire Safety Academy <no-reply@yourdomain.com>"

# Optional: your own long random secrets (otherwise generated once into data/secrets.json)
# JWT_SECRET=
# OTP_SECRET=

# Certificate (PDF)
ORG_NAME="City of Refuge"      # name printed as issuer on the certificate
SIGNATORY_NAME=                # optional: a name printed above the signature line
