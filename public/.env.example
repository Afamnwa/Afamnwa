# Copy to .env and edit. Never commit .env.
PORT=3000
NODE_ENV=production            # use "production" when served over HTTPS
TRUST_PROXY=1                  # set to 1 if behind nginx / a hosting proxy

# First admin account (created only if no admin exists yet).
# If ADMIN_PASSWORD is empty a random one is printed once in the console.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=

# Email (needed to send confirmation, reset and admin sign-in codes). Without it, codes are only printed in the server log.
# RECOMMENDED on Render: Resend's web API. (Render's free plan blocks the SMTP ports below.)
RESEND_API_KEY=                # re_xxxxxxxx  (resend.com > API Keys)
# MAIL_FROM must use an address on a domain you verified in Resend, e.g. "Fire Safety Academy <no-reply@yourdomain.com>"
# Alternative: classic SMTP (does NOT work on Render's free plan)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fire Safety Academy <no-reply@yourdomain.com>"

# Super Admin (can upload the certificate signature/logo, manage admins, run backups).
# If this account exists (and its email is confirmed) it is promoted at start-up; otherwise it is created. If empty, the oldest admin is promoted.
# It must be a REAL inbox you can open: admins sign in with a password plus an emailed code.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=           # blank = random password printed once in the console

# ADMIN_2FA=off                 # emergency switch only: turns off the emailed sign-in code for admins

# Backup of logins + every change to a PRIVATE GitHub repo (needed on Render, whose disk is erased on each deploy).
# Token: GitHub > Settings > Developer settings > Fine-grained tokens > only this repo > Contents: Read and write.
GITHUB_TOKEN=
GITHUB_BACKUP_REPO=            # owner/repo, e.g. cityofrefuge/fsa-data (private, with at least a README)
GITHUB_BACKUP_BRANCH=data-backup   # keep this different from the branch Render deploys, or every backup would redeploy the site
# GITHUB_BACKUP_PATH=backup/snapshot.json
# BACKUP_DELAY_SECONDS=30

# Optional: your own long random secrets (otherwise generated once into data/secrets.json)
# JWT_SECRET=
# OTP_SECRET=

# Certificate (PDF)
ORG_NAME="City of Refuge"      # name printed as issuer on the certificate
SIGNATORY_NAME=                # optional default name under the signature (the Super Admin can set it in the admin panel)
